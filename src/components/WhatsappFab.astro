---
import { whatsappUrl, ctaWhatsapp } from '../content/sitio';
import WhatsappIcon from './common/WhatsappIcon.astro';
---

<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={ctaWhatsapp}
  class="group fixed bottom-5 right-4 z-50 flex items-center gap-3 bg-wa px-5 py-4 font-body text-sm font-bold text-steel-900 shadow-[0_10px_30px_rgba(0,0,0,0.45)] transition-transform duration-200 hover:-translate-y-0.5 active:translate-y-0 md:bottom-8 md:right-8"
>
  <WhatsappIcon class="h-6 w-6" />
  <span class="hidden sm:inline">Escríbenos</span>
</a>
