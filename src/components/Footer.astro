---
import { sitio, navegacion, whatsappUrl, ctaWhatsapp } from '../content/sitio';
import WhatsappIcon from './common/WhatsappIcon.astro';
const anio = new Date().getFullYear();
---

<footer class="bg-steel-700 px-5 py-16 md:px-8 md:py-20">
  <div class="mx-auto max-w-[1400px]">
    <div class="grid gap-12 md:grid-cols-3">
      <div>
        <p class="display text-3xl text-bone">Rigo Box</p>
        <p class="mt-4 max-w-[34ch] font-body text-[15px] leading-relaxed text-bone/65">{sitio.eslogan}</p>
      </div>

      <nav aria-label="Pie de página">
        <ul class="space-y-3">
          {
            navegacion.map((item) => (
              <li>
                <a href={item.href} class="font-body text-[15px] text-bone/65 hover:text-bone">
                  {item.texto}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={sitio.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="font-body text-[15px] text-bone/65 hover:text-bone">Instagram</a
            >
          </li>
        </ul>
      </nav>

      <div>
        <p class="font-body text-[15px] leading-relaxed text-bone/65">{sitio.direccion}</p>
        <p class="mt-3 font-data text-sm text-bone/50">{sitio.horarioAtencion}</p>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center gap-2.5 bg-red px-6 py-3.5 font-body text-sm font-bold text-steel-900 transition-transform duration-200 hover:-translate-y-px"
        >
          <WhatsappIcon class="h-[1.15em] w-[1.15em]" />
          {ctaWhatsapp}
        </a>
      </div>
    </div>

    <p class="mt-14 border-t border-steel-600 pt-8 font-body text-[13px] text-bone/40">
      {anio} Rigo Box. {sitio.ciudad}. Fotografías de muestra, pendientes de sustituir por las del gimnasio.
    </p>
  </div>
</footer>
