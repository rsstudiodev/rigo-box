---
import { coaches } from '../../content/coaches';

const marcaEtiquetas = [
  { clave: 'ganadas', letra: 'G', titulo: 'Ganadas' },
  { clave: 'perdidas', letra: 'P', titulo: 'Perdidas' },
  { clave: 'empates', letra: 'E', titulo: 'Empates' },
  { clave: 'nocauts', letra: 'KO', titulo: 'Nocauts' },
] as const;
---

<section id="coaches" class="scroll-mt-[68px] bg-steel-800 px-5 py-24 md:px-8 md:py-32">
  <div class="mx-auto max-w-[1400px]">
    <div class="reveal max-w-[32ch]">
      <h2 class="display text-[clamp(2.25rem,5.5vw,4.25rem)] text-bone">Quién te va a entrenar</h2>
      <p class="mt-6 max-w-[52ch] font-body text-base leading-relaxed text-bone/75 md:text-lg">
        Peleadores en activo y formados en la casa. El que te corrige la guardia ya se subió al ring.
      </p>
    </div>

    <div class="mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {
        coaches.map((coach, i) => (
          <article class={`reveal flex flex-col ${i % 2 === 1 ? 'lg:mt-14' : ''}`}>
            <img
              src={coach.foto.url}
              alt={coach.foto.alt}
              loading="lazy"
              decoding="async"
              class="aspect-[4/5] w-full object-cover grayscale-[0.65] contrast-[1.05]"
            />
            <h3 class="display mt-6 text-2xl text-bone">{coach.nombre}</h3>
            <p class="mt-1 font-data text-xs tracking-wide text-red">{coach.rol}</p>
            {coach.marca && (
              <dl class="mt-5 grid grid-cols-4 border-y border-steel-600 py-4">
                {marcaEtiquetas.map(({ clave, letra, titulo }) => (
                  <div>
                    <dt class="sr-only">{titulo}</dt>
                    <dd>
                      <span
                        class={`block font-data text-2xl font-bold tabular-nums ${clave === 'ganadas' ? 'text-green' : 'text-bone'}`}
                      >
                        {coach.marca![clave]}
                      </span>
                      <span class="mt-1 block font-data text-[10px] tracking-widest text-bone/45">{letra}</span>
                    </dd>
                  </div>
                ))}
              </dl>
            )}

            <ul class={`space-y-2 ${coach.marca ? 'mt-5' : 'mt-6 border-t border-steel-600 pt-5'}`}>
              {coach.historial.map((linea) => (
                <li class="font-body text-[13px] leading-relaxed text-bone/55">{linea}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
