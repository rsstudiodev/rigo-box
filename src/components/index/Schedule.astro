---
import { modos } from '../../content/horarios';
import { whatsappUrl, ctaWhatsapp } from '../../content/sitio';

const R = 86;
const C = 100;

/** Point on the 24 hour dial. Hour 0 sits at the top, the clock runs clockwise. */
const punto = (hora: number, radio: number) => {
  const rad = ((hora / 24) * 360 - 90) * (Math.PI / 180);
  return [C + radio * Math.cos(rad), C + radio * Math.sin(rad)];
};

/** Arc covering the open window. */
const arco = (desde: number, hasta: number, radio: number) => {
  const [x1, y1] = punto(desde, radio);
  const [x2, y2] = punto(hasta, radio);
  const grande = (hasta - desde) / 24 > 0.5 ? 1 : 0;
  return `M ${x1} ${y1} A ${radio} ${radio} 0 ${grande} 1 ${x2} ${y2}`;
};

const horasMarcadas = [0, 3, 6, 9, 12, 15, 18, 21];
---

<section id="horarios" class="scroll-mt-[68px] bg-steel-900 px-5 py-24 md:px-8 md:py-32">
  <div class="mx-auto max-w-[1400px]">
    <div class="reveal max-w-[34ch]">
      <h2 class="display text-[clamp(2.25rem,5.5vw,4.25rem)] text-bone">No hay clases con hora fija</h2>
      <p class="mt-6 max-w-[52ch] font-body text-base leading-relaxed text-bone/75 md:text-lg">
        Rigo Box trabaja de dos formas. Llegas cuando puedes, no cuando te toca.
      </p>
    </div>

    <div class="mt-16 grid gap-px border border-steel-700 bg-steel-700 md:grid-cols-2">
      {
        modos.map((modo) => (
          <article class={`reveal p-8 md:p-12 ${modo.destacado ? 'bg-steel-800' : 'bg-steel-900'}`}>
            <svg viewBox="0 0 200 200" class="mx-auto block h-[220px] w-[220px] md:h-[260px] md:w-[260px]" role="img"
              aria-label={`${modo.nombre}, ${modo.franja}`}>
              <circle cx={C} cy={C} r={R} fill="none" stroke="#2E333A" stroke-width="14" />
              <path
                d={arco(modo.desde, modo.hasta, R)}
                fill="none"
                stroke={modo.destacado ? '#E2483A' : '#EDEAE4'}
                stroke-width="14"
                stroke-linecap="butt"
              />
              {horasMarcadas.map((h) => {
                const [x1, y1] = punto(h, R - 22);
                const [x2, y2] = punto(h, R - 15);
                const [tx, ty] = punto(h, R - 34);
                return (
                  <>
                    <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="#6B7280" stroke-width="1.5" />
                    <text
                      x={tx}
                      y={ty}
                      fill="#6B7280"
                      font-family="Roboto Mono, monospace"
                      font-size="9"
                      text-anchor="middle"
                      dominant-baseline="middle"
                    >
                      {String(h).padStart(2, '0')}
                    </text>
                  </>
                );
              })}
              <text
                x={C}
                y={C - 4}
                fill="#EDEAE4"
                font-family="Archivo Black, sans-serif"
                font-size="26"
                text-anchor="middle"
              >
                {modo.hasta - modo.desde} H
              </text>
              <text
                x={C}
                y={C + 16}
                fill="#6B7280"
                font-family="Roboto Mono, monospace"
                font-size="9"
                text-anchor="middle"
                letter-spacing="1"
              >
                ABIERTO
              </text>
            </svg>

            <h3 class="display mt-10 text-3xl text-bone md:text-4xl">{modo.nombre}</h3>
            <p class="mt-3 font-data text-sm text-red">{modo.franja}</p>
            <p class="mt-5 max-w-[42ch] font-body text-[15px] leading-relaxed text-bone/70">{modo.resumen}</p>

            <ul class="mt-7 space-y-3 border-t border-steel-600 pt-6">
              {modo.incluye.map((linea) => (
                <li class="font-body text-[15px] text-bone/70">{linea}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <p class="reveal mt-10 max-w-[62ch] font-body text-[15px] text-bone/55">
      Los dos modos son para todas las edades y todos los niveles. Si no sabes cuál te toca, pregúntanos.
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="ml-1 font-semibold text-bone underline underline-offset-4 hover:text-red">
        {ctaWhatsapp}
      </a>
    </p>
  </div>
</section>
