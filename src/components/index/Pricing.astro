---
import { precios } from '../../content/precios';
import { whatsappUrl, ctaWhatsapp } from '../../content/sitio';
import WhatsappIcon from '../common/WhatsappIcon.astro';
---

<section id="precios" class="scroll-mt-[68px] bg-steel-900 px-5 py-24 md:px-8 md:py-32">
  <div class="mx-auto max-w-[1400px]">
    <div class="reveal max-w-[30ch]">
      <h2 class="display text-[clamp(2.25rem,5.5vw,4.25rem)] text-bone">Lo que cuesta entrenar</h2>
      <p class="mt-6 max-w-[50ch] font-body text-base leading-relaxed text-bone/75 md:text-lg">
        Dos planes, sin clase suelta. Los dos dan acceso al horario corrido y al Open Box.
      </p>
    </div>

    <div class="mt-16 grid gap-px border border-steel-700 bg-steel-700 md:grid-cols-2">
      {
        precios.map((plan) => (
          <article class={`reveal flex flex-col p-8 md:p-12 ${plan.destacado ? 'bg-steel-800' : 'bg-steel-900'}`}>
            <h3 class="display text-3xl text-bone md:text-4xl">{plan.nombre}</h3>

            <p class="mt-8 flex items-baseline gap-3">
              <span class="display text-[clamp(3.5rem,9vw,6rem)] text-red">${plan.monto}</span>
              <span class="font-data text-sm text-bone/55">{plan.unidad}</span>
            </p>

            <p class="mt-6 max-w-[42ch] font-body text-[15px] leading-relaxed text-bone/70">{plan.resumen}</p>

            <ul class="mt-8 space-y-3 border-t border-steel-600 pt-6">
              {plan.incluye.map((linea) => (
                <li class="font-body text-[15px] text-bone/70">{linea}</li>
              ))}
            </ul>

            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-10 flex items-center justify-center gap-2.5 bg-red px-6 py-4 font-body text-sm font-bold text-steel-900 transition-transform duration-200 hover:-translate-y-px"
            >
              <WhatsappIcon class="h-[1.15em] w-[1.15em]" />
              {ctaWhatsapp}
            </a>
          </article>
        ))
      }
    </div>

    <p class="reveal mt-8 font-body text-[15px] text-bone/50">
      Precios en pesos mexicanos. Pregúntanos por la clase de prueba.
    </p>
  </div>
</section>
